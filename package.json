{
  "name": "@hasparus/definitely-not-vercel-og",
  "version": "1.0.3",
  "description": "@vercel/og 1.0.3 rebuilt against current satori",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasparus/definitely-not-vercel-og.git"
  },
  "type": "module",
  "main": "./dist/index.node.js",
  "types": "./dist/index.node.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "edge": {
        "types": "./dist/index.edge.d.ts",
        "default": "./dist/index.edge.js"
      },
      "edge-light": {
        "types": "./dist/index.edge.d.ts",
        "default": "./dist/index.edge.js"
      },
      "browser": {
        "types": "./dist/index.edge.d.ts",
        "default": "./dist/index.edge.js"
      },
      "worker": {
        "types": "./dist/index.edge.d.ts",
        "default": "./dist/index.edge.js"
      },
      "workerd": {
        "types": "./dist/index.edge.d.ts",
        "default": "./dist/index.edge.js"
      },
      "import": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "default": "./dist/index.node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && tsup && node scripts/copy-assets.js",
    "test": "node --test",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "open graph image",
    "open graph",
    "og image",
    "og:image",
    "social",
    "card",
    "image"
  ],
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "satori": "^0.63.2"
  },
  "peerDependencies": {
    "sharp": ">=0.34"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "sharp": "^0.35.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1"
}
